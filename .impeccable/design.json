  "narrative": {
    "northStar": "Personal website companion",
    "overview": "Project Reboot inherits its visual authority from the sibling personal website at `../Personal Website/Final Ver.`: cream ground, deep blue accents, dark ink, restrained maize details, and self-hosted Mona Sans paired with Brygada 1918. This record merges the provisional design decisions with `src/styles.css` and the React components. No approved visual comp was supplied; implementation follows explicit user visual rules and the personal website source.\n\nThe workspace favors quiet section rules, readable task rows, and editorial headings. Its signature is the jagged, directly editable Journey line, echoed by the ascending line mark in navigation. Color and shape communicate state with selective tonal containers. Motion supports immediate control feedback and the mobile drawer; the chart responds directly without animation.",
    "keyCharacteristics": [
      "Cream surfaces with deep blue controls and restrained maize markers.",
      "Serif headings and reflection text, sans-serif controls and dense records.",
      "Flat, ruled layouts with compact task rows and selective tonal panels.",
      "A jagged Journey graph that exposes recorded, missing, neutral, and milestone states.",
      "Responsive layouts and explicit keyboard editing alongside pointer input."
    ],
    "rules": [
      {
        "name": "The Restrained Accent Rule",
        "body": "Use maize for small markers and interaction emphasis; preserve cream and blue as the dominant identity.",
        "section": "colors"
      },
      {
        "name": "The Role Pairing Rule",
        "body": "Keep Brygada 1918 for headings and reflection; keep Mona Sans for controls, labels, numbers, and dense records.",
        "section": "typography"
      },
      {
        "name": "The Flat Workspace Rule",
        "body": "Prefer rules and tonal grouping; reserve shadows for the selected segment and mobile navigation.",
        "section": "elevation"
      },
      {
        "name": "The Honest Line Rule",
        "body": "Preserve the distinction between recorded and missing Journey days, and keep the curve directly controlled by the user rather than inferred from habit completion.",
        "section": "components"
      }
    ],
    "dos": [
      "**Do** preserve the inherited cream, blue, ink, and restrained maize palette.",
      "**Do** use self-hosted Mona Sans for controls and Brygada 1918 for headings and reflection.",
      "**Do** group daily work with precise rows, section rules, and selective tonal containers.",
      "**Do** keep recorded, missing, neutral, future, and historical states visibly distinct.",
      "**Do** retain pointer and keyboard Journey editing, visible focus, and reduced-motion behavior.",
      "**Do** preserve English default goal labels and the available Vietnamese label choices."
    ],
    "donts": [
      "**Don't** replace the personal website identity with a new palette or font pairing.",
      "**Don't** fill the Journey chart with fabricated activity or smooth its jagged segments.",
      "**Don't** present subjective Journey movement as automatically derived objective progress.",
      "**Don't** replace the ruled workspace with a grid of decorative statistic cards.",
      "**Don't** add animation during chart dragging or when reduced motion is requested.",
      "**Don't** claim a universal 44px control minimum, 12px panel radius, or general panel entrance animation from the provisional record."
