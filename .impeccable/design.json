      "css": ".ds-journey{margin:0;background:var(--cream,#f5f0e6)}.ds-chart{display:block;width:100%;cursor:crosshair}.ds-chart:focus-visible{outline:2px solid var(--maize,#c79a2b);outline-offset:4px;}.ds-chart-rule{fill:none;stroke:#d8dcd8;stroke-width:.7}.ds-caption{font-family:var(--sans,'Mona Sans','Helvetica Neue',Arial,sans-serif);font-size:10px;fill:var(--muted,#566273);letter-spacing:.04em}.ds-empty{font-family:var(--serif,'Brygada 1918',Georgia,serif);font-size:24px;fill:var(--blue,#0b2d5c)}.ds-missing{fill:none;stroke:var(--blue,#0b2d5c);stroke-width:2.5;stroke-dasharray:3 7;opacity:.32}.ds-legend{font-family:var(--sans,'Mona Sans','Helvetica Neue',Arial,sans-serif);display:flex;gap:7px;align-items:center;font-size:10px;color:var(--muted,#566273);padding:9px 0;flex-wrap:wrap}.ds-line{width:18px;border-top:2px solid var(--blue,#0b2d5c)}.ds-line-missing{border-top-style:dashed;opacity:.4}@media(max-width:650px){.ds-caption{font-size:9px}.ds-empty{font-size:22px}.ds-legend{font-size:8px}}"
